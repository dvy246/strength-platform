---
// src/pages/contact.astro
import PageLayout from '@/layouts/PageLayout.astro';
import Container from '@/components/layout/Container.astro';
import Section from '@/components/layout/Section.astro';
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro';
import { ContactForm } from '@/components/shared/ContactForm';
import { Mail, ShieldCheck, Clock } from 'lucide-react';

const breadcrumbs = [{ name: 'Contact Us', path: '/contact' }];
---

<PageLayout
  title="Contact Us | StrengthChecker"
  description="Have questions, suggestions, or feedback about our strength standards or calculators? Reach out to the StrengthChecker team."
  canonicalPath="/contact"
>
  <Section class="pt-6 md:pt-10">
    <Container>
      <Breadcrumbs items={breadcrumbs} />

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 mt-6">
        {/* Info Column */}
        <div class="lg:col-span-5 space-y-6">
          <div>
            <h1 class="text-4xl font-extrabold tracking-tight text-foreground sm:text-5xl">
              Get in <span class="text-primary">Touch</span>
            </h1>
            <p class="mt-3 text-base text-muted-foreground leading-relaxed">
              We value your feedback. Whether you are a strength coach requesting standard integrations, a researcher pointing out study sources, or a lifter reporting an edge case, feel free to drop us a line.
            </p>
          </div>

          <div class="space-y-4 pt-4">
            <div class="flex items-start space-x-4 p-4 rounded-xl border border-border bg-card/40">
              <div class="p-2.5 border border-primary/20 bg-primary/10 rounded-xl text-primary shrink-0">
                <Mail className="h-5 w-5" />
              </div>
              <div class="space-y-1 min-w-0">
                <h3 class="text-sm font-semibold text-foreground">Direct Support Email</h3>
                <a href="mailto:support@strengthchecker.com" class="text-sm text-primary hover:underline font-mono break-all">
                  support@strengthchecker.com
                </a>
              </div>
            </div>

            <div class="flex items-start space-x-4 p-4 rounded-xl border border-border bg-card/40">
              <div class="p-2.5 border border-border bg-card rounded-xl text-muted-foreground shrink-0">
                <Clock className="h-5 w-5" />
              </div>
              <div class="space-y-1">
                <h3 class="text-sm font-semibold text-foreground">Response SLA</h3>
                <p class="text-xs text-muted-foreground leading-relaxed">
                  We typically review incoming inquiries and data suggestions within 24–48 business hours.
                </p>
              </div>
            </div>

            <div class="flex items-start space-x-4 p-4 rounded-xl border border-border bg-card/40">
              <div class="p-2.5 border border-border bg-card rounded-xl text-muted-foreground shrink-0">
                <ShieldCheck className="h-5 w-5" />
              </div>
              <div class="space-y-1">
                <h3 class="text-sm font-semibold text-foreground">Mathematical Integrity</h3>
                <p class="text-xs text-muted-foreground leading-relaxed">
                  All mathematical model updates (log-normal parameters, Master age multipliers) are verified against empirical datasets before rollout.
                </p>
              </div>
            </div>
          </div>
        </div>

        {/* Form Column */}
        <div class="lg:col-span-7">
          <ContactForm client:load />
        </div>
      </div>
    </Container>
  </Section>
</PageLayout>
