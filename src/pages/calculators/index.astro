---
// src/pages/calculators/index.astro
import PageLayout from '@/layouts/PageLayout.astro';
import Container from '@/components/layout/Container.astro';
import Section from '@/components/layout/Section.astro';
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro';

const breadcrumbs = [{ name: 'Calculators', path: '/calculators' }];
---

<PageLayout
  title="Strength & Fitness Calculators — Powerlifting & Biometrics"
  description="Free precision strength calculators: 1RM estimators, DOTS/Wilks powerlifting scoring, composite Strength Index, Body Fat, and VO2 Max protocols."
  canonicalPath="/calculators"
>
  <Section class="pt-6 md:pt-10">
    <Container>
      <Breadcrumbs items={breadcrumbs} />

      <div class="mb-12">
        <h1 class="text-4xl font-extrabold tracking-tight text-foreground sm:text-5xl">
          Strength <span class="text-gradient">Calculators</span>
        </h1>
        <p class="mt-3 text-lg text-muted-foreground max-w-2xl">
          Scientific, data-driven calculators designed to assess your performance, optimize your training zones, and track your development.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-12">
        {/* Strength Index Card */}
        <div class="flex flex-col justify-between p-8 border border-border rounded-2xl bg-card hover:border-primary/40 hover:shadow-md transition-all duration-300 group">
          <div>
            <span class="text-xs font-semibold uppercase tracking-widest text-primary font-mono">Flagship</span>
            <h2 class="text-2xl font-bold text-foreground mt-3 group-hover:text-primary transition-colors">
              Strength Index Calculator
            </h2>
            <p class="text-muted-foreground text-sm mt-3 leading-relaxed">
              Synthesize your performance across multiple movements into a single score from 0 to 100. Get customized profile analysis, percentile ratings, and muscle balance charts.
            </p>
          </div>
          <div class="mt-8">
            <a
              href="/calculators/strength-index"
              class="inline-flex items-center justify-center rounded-lg bg-primary px-4 py-2.5 text-xs font-bold text-primary-foreground hover:bg-primary/95 shadow-sm transition-all"
            >
              Calculate Strength Index
            </a>
          </div>
        </div>

        {/* One Rep Max Card */}
        <div class="flex flex-col justify-between p-8 border border-border rounded-2xl bg-card hover:border-primary/40 hover:shadow-md transition-all duration-300 group">
          <div>
            <span class="text-xs font-semibold uppercase tracking-widest text-muted-foreground font-mono">Training Math</span>
            <h2 class="text-2xl font-bold text-foreground mt-3 group-hover:text-primary transition-colors">
              One Rep Max Calculator
            </h2>
            <p class="text-muted-foreground text-sm mt-3 leading-relaxed">
              Estimate your absolute single-rep capability for any movement based on your rep performance. Compares 6 major equations and outputs percent-based load charts.
            </p>
          </div>
          <div class="mt-8">
            <a
              href="/calculators/one-rep-max-calculator"
              class="inline-flex items-center justify-center rounded-lg border border-border bg-muted/50 px-4 py-2.5 text-xs font-bold text-foreground hover:bg-muted transition-all"
            >
              Estimate One-Rep Max
            </a>
          </div>
        </div>

        {/* Ideal Bodyweight Card */}
        <div class="flex flex-col justify-between p-8 border border-border rounded-2xl bg-card hover:border-primary/40 hover:shadow-md transition-all duration-300 group">
          <div>
            <span class="text-xs font-semibold uppercase tracking-widest text-muted-foreground font-mono">Physique targets</span>
            <h2 class="text-2xl font-bold text-foreground mt-3 group-hover:text-primary transition-colors">
              Ideal Bodyweight Calculator
            </h2>
            <p class="text-muted-foreground text-sm mt-3 leading-relaxed">
              Find your recommended, athletic, and strength-focused weight classes based on height structure and experience, with target standards.
            </p>
          </div>
          <div class="mt-8">
            <a
              href="/calculators/ideal-bodyweight"
              class="inline-flex items-center justify-center rounded-lg border border-border bg-muted/50 px-4 py-2.5 text-xs font-bold text-foreground hover:bg-muted transition-all"
            >
              Find Ideal Weight
            </a>
          </div>
        </div>

        {/* Relative Strength Card */}
        <div class="flex flex-col justify-between p-8 border border-border rounded-2xl bg-card hover:border-primary/40 hover:shadow-md transition-all duration-300 group">
          <div>
            <span class="text-xs font-semibold uppercase tracking-widest text-muted-foreground font-mono">Neuromuscular</span>
            <h2 class="text-2xl font-bold text-foreground mt-3 group-hover:text-primary transition-colors">
              Relative Strength Calculator
            </h2>
            <p class="text-muted-foreground text-sm mt-3 leading-relaxed">
              Analyze your absolute lift relative to your bodyweight, mapping ratios to Beginner through Elite tiers with percentile curves.
            </p>
          </div>
          <div class="mt-8">
            <a
              href="/calculators/relative-strength"
              class="inline-flex items-center justify-center rounded-lg border border-border bg-muted/50 px-4 py-2.5 text-xs font-bold text-foreground hover:bg-muted transition-all"
            >
              Analyze Ratio
            </a>
          </div>
        </div>

        {/* Powerlifting Score Card */}
        <div class="flex flex-col justify-between p-8 border border-border rounded-2xl bg-card hover:border-primary/40 hover:shadow-md transition-all duration-300 group">
          <div>
            <span class="text-xs font-semibold uppercase tracking-widest text-muted-foreground font-mono">Competition</span>
            <h2 class="text-2xl font-bold text-foreground mt-3 group-hover:text-primary transition-colors">
              Wilks & Powerlifting Score
            </h2>
            <p class="text-muted-foreground text-sm mt-3 leading-relaxed">
              Calculate your Wilks score, DOTS score, and IPF GL points dynamically. Compare your relative powerlifting performance.
            </p>
          </div>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href="/calculators/wilks-calculator"
              class="inline-flex items-center justify-center rounded-lg border border-border bg-muted/50 px-4 py-2.5 text-xs font-bold text-foreground hover:bg-muted transition-all"
            >
              Calculate Wilks
            </a>
            <a
              href="/compare/dots-vs-wilks-vs-ipf-gl"
              class="inline-flex items-center justify-center rounded-lg border border-primary/20 bg-primary/5 px-4 py-2.5 text-xs font-bold text-primary hover:bg-primary/10 transition-all"
            >
              Compare Formulas
            </a>
          </div>
        </div>

        {/* Strength Ratio Card */}
        <div class="flex flex-col justify-between p-8 border border-border rounded-2xl bg-card hover:border-primary/40 hover:shadow-md transition-all duration-300 group">
          <div>
            <span class="text-xs font-semibold uppercase tracking-widest text-muted-foreground font-mono">Symmetry</span>
            <h2 class="text-2xl font-bold text-foreground mt-3 group-hover:text-primary transition-colors">
              Strength Ratio Checker
            </h2>
            <p class="text-muted-foreground text-sm mt-3 leading-relaxed">
              Check your relative balance across core lifts (squat, bench, deadlift, overhead press, rows) to identify muscle imbalances and joint risks.
            </p>
          </div>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href="/calculators/strength-ratio-checker"
              class="inline-flex items-center justify-center rounded-lg border border-border bg-muted/50 px-4 py-2.5 text-xs font-bold text-foreground hover:bg-muted transition-all"
            >
              Check Ratios
            </a>
            <a
              href="/guides/ideal-strength-ratios"
              class="inline-flex items-center justify-center rounded-lg border border-primary/20 bg-primary/5 px-4 py-2.5 text-xs font-bold text-primary hover:bg-primary/10 transition-all"
            >
              View Ratios Guide
            </a>
          </div>
        </div>

        {/* Strength Standards by Age Card */}
        <div class="flex flex-col justify-between p-8 border border-border rounded-2xl bg-card hover:border-primary/40 hover:shadow-md transition-all duration-300 group">
          <div>
            <span class="text-xs font-semibold uppercase tracking-widest text-muted-foreground font-mono">Demographics</span>
            <h2 class="text-2xl font-bold text-foreground mt-3 group-hover:text-primary transition-colors">
              Strength Standards by Age
            </h2>
            <p class="text-muted-foreground text-sm mt-3 leading-relaxed">
              Calculate your age-adjusted strength standards using the official McCulloch coefficients. Compare your squat, bench, and deadlift within your age bracket.
            </p>
          </div>
          <div class="mt-8">
            <a
              href="/calculators/strength-standards-by-age"
              class="inline-flex items-center justify-center rounded-lg border border-border bg-muted/50 px-4 py-2.5 text-xs font-bold text-foreground hover:bg-muted transition-all"
            >
              Calculate by Age
            </a>
          </div>
        </div>

        {/* Body Fat Calculator Card */}
        <div class="flex flex-col justify-between p-8 border border-border rounded-2xl bg-card hover:border-primary/40 hover:shadow-md transition-all duration-300 group">
          <div>
            <span class="text-xs font-semibold uppercase tracking-widest text-muted-foreground font-mono">Body Composition</span>
            <h2 class="text-2xl font-bold text-foreground mt-3 group-hover:text-primary transition-colors">
              Body Fat Percentage Calculator
            </h2>
            <p class="text-muted-foreground text-sm mt-3 leading-relaxed">
              Estimate your body fat percentage using the US Navy Tape Measure method or the BMI regression formula. View ideal charts, tracking guides, and health recommendations.
            </p>
          </div>
          <div class="mt-8">
            <a
              href="/calculators/body-fat-calculator"
              class="inline-flex items-center justify-center rounded-lg border border-border bg-muted/50 px-4 py-2.5 text-xs font-bold text-foreground hover:bg-muted transition-all"
            >
              Calculate Body Fat
            </a>
          </div>
        </div>

        {/* Pull-Ups One Rep Max Card */}
        <div class="flex flex-col justify-between p-8 border border-border rounded-2xl bg-card hover:border-primary/40 hover:shadow-md transition-all duration-300 group">
          <div>
            <span class="text-xs font-semibold uppercase tracking-widest text-muted-foreground font-mono">Calisthenics</span>
            <h2 class="text-2xl font-bold text-foreground mt-3 group-hover:text-primary transition-colors">
              Pull-Ups 1 Rep Max Calculator
            </h2>
            <p class="text-muted-foreground text-sm mt-3 leading-relaxed">
              Calculate your pull-up and weighted pull-up one rep max (1RM) using scientific formulas adjusted for calisthenics bodyweight loads.
            </p>
          </div>
          <div class="mt-8">
            <a
              href="/calculators/pull-ups-one-rep-max-calculator"
              class="inline-flex items-center justify-center rounded-lg border border-border bg-muted/50 px-4 py-2.5 text-xs font-bold text-foreground hover:bg-muted transition-all"
            >
              Calculate Pull-Up Max
            </a>
          </div>
        </div>

        {/* VO2 Max Calculator Card */}
        <div class="flex flex-col justify-between p-8 border border-border rounded-2xl bg-card hover:border-primary/40 hover:shadow-md transition-all duration-300 group">
          <div>
            <span class="text-xs font-semibold uppercase tracking-widest text-muted-foreground font-mono">Conditioning</span>
            <h2 class="text-2xl font-bold text-foreground mt-3 group-hover:text-primary transition-colors">
              VO₂ Max & Aerobic Capacity
            </h2>
            <p class="text-muted-foreground text-sm mt-3 leading-relaxed">
              Estimate your VO₂ Max and cardiorespiratory rating using 4 validated tests: Cooper 12-Min, Rockport Walk, 1.5-Mile Run, and Heart Rate. Compare with ACSM charts.
            </p>
          </div>
          <div class="mt-8">
            <a
              href="/calculators/vo2-max-calculator"
              class="inline-flex items-center justify-center rounded-lg border border-border bg-muted/50 px-4 py-2.5 text-xs font-bold text-foreground hover:bg-muted transition-all"
            >
              Calculate VO₂ Max
            </a>
          </div>
        </div>
      </div>

      {/* Learning Resources */}
      <div class="mt-16 pt-12 border-t border-border space-y-6">
        <h2 class="text-2xl font-bold text-foreground">Learning Resources</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="p-6 border border-border bg-card rounded-2xl shadow-sm space-y-3">
            <h3 class="text-lg font-bold text-foreground">Strength Training Glossary</h3>
            <p class="text-muted-foreground text-sm leading-relaxed">
              Explore plain-English definitions of essential training and powerlifting terminology like 1RM, RPE, RIR, Wilks, and progressive overload.
            </p>
            <a href="/glossary" class="inline-flex items-center text-xs font-bold text-primary hover:underline mt-2">
              Browse Glossary →
            </a>
          </div>
          <div class="p-6 border border-border bg-card rounded-2xl shadow-sm space-y-3">
            <h3 class="text-lg font-bold text-foreground">Testing Methodology</h3>
            <p class="text-muted-foreground text-sm leading-relaxed">
              Understand the science behind our calculations. Learn how we normalize and evaluate physical standards for general and athletic populations.
            </p>
            <a href="/methodology" class="inline-flex items-center text-xs font-bold text-primary hover:underline mt-2">
              Read Methodology →
            </a>
          </div>
        </div>
      </div>
    </Container>
  </Section>
</PageLayout>
